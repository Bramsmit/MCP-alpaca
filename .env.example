# Alpaca API (paper trading)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER_TRADE=True

# Telegram (trade-notificaties)
# 1. Maak bot via @BotFather op Telegram
# 2. Stuur /start naar je bot
# 3. Haal Chat ID op: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Kraken spot USD — kraken.live_trader (CI: trade_kraken.yml)
KRAKEN_API_KEY=
KRAKEN_SECRET_KEY=
KRAKEN_DRY_RUN=false
KRAKEN_POST_ONLY=false
# TELEGRAM_BOT_TOKEN_KRAKEN=
# TELEGRAM_CHAT_ID_KRAKEN=
# KRAKEN_BOT_TRADE_LOG=     # uit: false/off; default kraken_bot_trades.jsonl
